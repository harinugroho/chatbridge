# ===========================================
# Chatwoot ↔ WhatsApp Bridge Configuration
# ===========================================

# Database
DATABASE_URL=postgres://chatbridge:chatbridge@postgres:5432/chatbridge?sslmode=disable

# Chatwoot API
CHATWOOT_BASE_URL=https://chat.indieapps.id
CHATWOOT_BOT_TOKEN=your_chatwoot_bot_token_here
CHATWOOT_USER_TOKEN=your_chatwoot_user_token_here

# WhatsApp (wwebjs-api)
WHATSAPP_BASE_URL=http://wwebjs:3000
WHATSAPP_TOKEN=your_whatsapp_api_key_here

# Application
LISTEN_PORT=8080

# System phone number (admin/bot control number in Chatwoot)
SYSTEM_PHONE_NUMBER=+62111111
