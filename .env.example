# ===========================================
# Chatwoot ↔ WhatsApp Bridge Configuration
# ===========================================

# Postgres Configuration
POSTGRES_USER=chatbridge
POSTGRES_PASSWORD=chatbridge
POSTGRES_DB=chatbridge

# WhatsApp Web API Configuration
WHATSAPP_TOKEN=your-secret-token
BASE_WEBHOOK_URL=http://chatbridge:8080/webhook/whatsapp
MAX_ATTACHMENT_SIZE=5000000
SET_MESSAGES_AS_SEEN=TRUE
ENABLE_SWAGGER_ENDPOINT=FALSE
WEB_VERSION=2.3000.1031490220-alpha
WEB_VERSION_CACHE_TYPE=remote

# Chatbridge App Configuration
DATABASE_URL=postgres://chatbridge:chatbridge@postgres:5432/chatbridge?sslmode=disable
CHATWOOT_BASE_URL=http://localhost:3000
WHATSAPP_BASE_URL=http://wwebjs:3000
LISTEN_PORT=8080
SYSTEM_PHONE_NUMBER=+62111111

